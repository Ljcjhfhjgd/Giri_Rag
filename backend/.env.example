# ============================================================
# 极睿知识库 环境变量模板
#
# 用法：复制为 .env 后按下方说明填写
#   cp backend/.env.example backend/.env
#
# 注意：backend/.env 已被 .gitignore 排除，绝不会提交到仓库。
#       绝不要把真实密钥写进这个模板文件。
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=极睿知识库
APP_VERSION=0.1.0
# 生产环境保持 false。true 会开放 /docs 与 /redoc 接口文档。
DEBUG=false
TZ=Asia/Shanghai

# ---------------- 数据库 ----------------
# 留空 = 使用 SQLite（按 DATA_DIR 推导，适配小内存单机部署）
# 切 PostgreSQL 时填完整 DSN：
#   postgresql+asyncpg://jirui:密码@127.0.0.1:5432/jirui_kb
DATABASE_URL=
# 打印 SQL，调试用，生产保持 false
DB_ECHO=false

# ---------------- 认证（部署前必须重新生成）----------------
# 生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_必须重新生成
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# 用于加密数据库中存储的模型 API Key（Fernet 密钥，base64 32 字节）
# 生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 一旦有数据后再更换此值，数据库中已加密的 API Key 将全部无法解密，
#    必须在「模型管理」里重新录入。
SECRET_ENCRYPTION_KEY=CHANGE_ME_必须重新生成

# ---------------- 初始管理员（部署前改掉）----------------
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=CHANGE_ME_换成强密码
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_EMAIL=admin@example.com

# ---------------- 检索内核 ----------------
# local   = 内置轻量内核（SQLite + 本地 ONNX 嵌入），2 核 / 2 GB 可跑
# ragflow = 外部 RAGFlow 服务，需 4 核 / 16 GB 级别机器
RETRIEVAL_BACKEND=local
# 留空则按 DATA_DIR 推导为 <DATA_DIR>/index/chunks.db
INDEX_DB_PATH=

# ---------------- 嵌入模型 ----------------
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_DIM=512
# 留空则按 backend/models/bge-small-zh-v1.5 推导
# 部署时建议显式指向项目根目录下的 models/
# LOCAL_EMBEDDING_DIR=/opt/jirui/app/models/bge-small-zh-v1.5
LOCAL_EMBEDDING_DIR=
LOCAL_EMBEDDING_MAX_TOKENS=512
EMBED_BATCH_SIZE=16
# 小内存机器保持 false：开启后 onnxruntime 会缓存一大块内存且终身不归还
EMBEDDING_MEM_ARENA=false

# ---------------- 数据目录 ----------------
# 生产环境建议用绝对路径
DATA_DIR=/opt/jirui/app/data
MAX_UPLOAD_SIZE_MB=200

# ---------------- 默认模型（可留空，登录后台手动添加）----------------
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
# 留空则跳过初始化，登录后到「模型管理」手动添加
DEFAULT_LLM_API_KEY=

# ---------------- CORS ----------------
# `null` 不能删：Electron 桌面端从 file:// 加载，Origin 就是字面量 "null"
# 生产环境把域名加进来，例如：null,https://kb.example.com
ALLOWED_ORIGINS=null,http://localhost,http://127.0.0.1

# ---------------- 版本更新（桌面端）----------------
# 留空 = 使用本服务自身的 /api/v1/system/updates/desktop
UPDATE_FEED_URL=
DESKTOP_LATEST_VERSION=0.1.0

# ---------------- RAGFlow（RETRIEVAL_BACKEND=ragflow 时才需要）----------------
RAGFLOW_BASE_URL=http://ragflow:9380
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT=120
