# 统一换行符：本项目部署目标是 Linux，所有文本文件一律 LF。
# 不加这个文件时，Windows 上签出的 .sh 会带 CRLF，
# 传到 Linux 后执行会报 "/bin/bash^M: bad interpreter: No such file or directory"。
* text=auto eol=lf

# shell 脚本与 systemd 单元必须 LF
*.sh          text eol=lf
*.service     text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.json        text eol=lf
*.cfg         text eol=lf
*.ini         text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows 批处理反过来
*.bat         text eol=crlf
*.cmd         text eol=crlf

# 二进制文件不做任何转换
*.png         binary
*.jpg         binary
*.jpeg        binary
*.ico         binary
*.db          binary
*.onnx        binary
*.onnx_data   binary
*.pdf         binary
*.docx        binary
*.xlsx        binary
